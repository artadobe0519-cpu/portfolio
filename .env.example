# Public site URL used for canonical links, Open Graph URLs, the sitemap, and robots.txt.
# Set this to the real production domain before launch. Do not invent a domain.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=

# Gmail SMTP for the enquiry form. Leave blank until you are ready.
# All three values are required before the form will send email.
# The site never pretends a message was sent when these are missing.
# Use a Gmail app password, not the normal account password.
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# Password for /admin. The work library will not open until this is set.
ADMIN_PASSWORD=
